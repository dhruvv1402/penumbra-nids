__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
dist/
build/
*.egg-info/

# Node
console/node_modules/
console/.next/
console/out/

# Local
.env
.env.local
*.log
