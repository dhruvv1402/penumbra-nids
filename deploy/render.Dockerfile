# Penumbra API for Render's free tier (512 MB RAM). Built by Render from this repository: render.yaml.
#
# Git does not carry the models, sample pools, reports or the ATT&CK corpus; they are fetched from
# the Hugging Face model repo at build time (scripts/publish_hf.py writes it, scripts/fetch_bundle.py
# reads it and checks each detector's SHA-256 against the Hub's record).
#
# Only the champions that fit are fetched. Measured: the API idles at ~290 MB and holds ~300 MB with
# NSL-KDD and CICIDS loaded; UNSW alone is ~750 MB in memory. So this instance scores NSL-KDD and
# CICIDS, and pcap upload (which assembles flows in the UNSW schema) is not offered here.
#
# No demo users, as in every image: guest access is read-only, the role passwords are generated by
# Render (render.yaml) and live only in its environment.

FROM python:3.12-slim-bookworm AS builder

COPY --from=ghcr.io/astral-sh/uv:0.5.11 /uv /bin/
ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=never

WORKDIR /app
COPY pyproject.toml uv.lock README.md ./
RUN uv sync --frozen --no-install-project --extra eval --extra api --extra rag --extra drift
COPY src/ ./src/
RUN uv sync --frozen --extra eval --extra api --extra rag --extra drift


FROM python:3.12-slim-bookworm AS runtime

RUN useradd --create-home --uid 10001 penumbra
WORKDIR /app

COPY --from=builder --chown=penumbra:penumbra /app/.venv /app/.venv
COPY --from=builder --chown=penumbra:penumbra /app/src /app/src
COPY --chown=penumbra:penumbra pyproject.toml README.md ./
COPY --chown=penumbra:penumbra tests/fixtures/demo_alerts.json tests/fixtures/incidents_cicids.json /app/seed/

ARG HF_REPO=dhruvv1402/penumbra-nids
ARG PENUMBRA_MODELS="nslkdd cicids"
COPY scripts/fetch_bundle.py /tmp/fetch_bundle.py
RUN python /tmp/fetch_bundle.py --repo "$HF_REPO" --dest /app --models $PENUMBRA_MODELS \
    && rm /tmp/fetch_bundle.py \
    && mkdir -p /app/data /app/state \
    && chown -R penumbra:penumbra /app/bundle /app/data /app/state

ENV PATH="/app/.venv/bin:$PATH" \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PENUMBRA_DATA_ROOT=/app/data \
    PENUMBRA_ARTIFACT_ROOT=/app/bundle \
    PENUMBRA_STATE_ROOT=/app/state \
    PENUMBRA_SEED_FIXTURES=/app/seed

USER penumbra
EXPOSE 10000

# Render routes to $PORT (10000 unless set).
CMD ["sh", "-c", "exec uvicorn penumbra.api.app:app --host 0.0.0.0 --port ${PORT:-10000}"]
