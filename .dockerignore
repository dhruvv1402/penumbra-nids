# Everything the image does not need. Keeping the build context small matters here: data/ is a
# junction to G: holding ~3 GB of CSVs, and sending that to the daemon would dominate build time.
.git/
.github/
data/
artifacts/
console/
notebooks/
docs/
sentinel/
tests/
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
.mypy_cache/
CONTEXT.md
requirements-audit.txt
*.joblib
*.db
*.jsonl

# Re-included for deploy/api.Dockerfile only (the main Dockerfile never copies them): the reports the
# console renders and the two demo fixtures. Absent in a clean checkout, which is fine.
!artifacts/reports/
!tests/fixtures/demo_alerts.json
!tests/fixtures/incidents_cicids.json

# Live scoring (ADR-0006): the staged registry champions must survive the *.joblib rule above.
!deploy/models/
!deploy/models/**
!deploy/samples/
!deploy/samples/**
